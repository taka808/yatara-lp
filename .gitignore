# 未発表音源をこの公開リポジトリに絶対に入れない（LP正本側の audio/ は Drive にある）
audio/
*.mp3
*.wav
*.m4a
*.aif
*.aiff
*.flac

# Public demo page is intentionally allowed to carry its own audio.
!demo/
!demo/audio/
!demo/audio/*.mp3

# Public no-bass demo page carries its own audio.
!nobass/
!nobass/audio/
!nobass/audio/*.mp3
